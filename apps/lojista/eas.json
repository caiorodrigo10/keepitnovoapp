{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "demo": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_APP_ENV": "qa"
      }
    },
    "demo-apk": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_APP_ENV": "qa"
      }
    },
    "homolog": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "supabase",
        "EXPO_PUBLIC_APP_ENV": "homologacao"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "supabase",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "demo": {
      "ios": {
        "ascAppId": "6796881536",
        "ascApiKeyPath": "credentials/AuthKey.p8",
        "ascApiKeyId": "T5CQNTR77Y",
        "ascApiKeyIssuerId": "207349a8-a4fb-4b33-a791-c3b66358f3d1"
      },
      "android": {
        "serviceAccountKeyPath": "/root/.secrets/keepit-play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6796881536",
        "ascApiKeyPath": "credentials/AuthKey.p8",
        "ascApiKeyId": "T5CQNTR77Y",
        "ascApiKeyIssuerId": "207349a8-a4fb-4b33-a791-c3b66358f3d1"
      },
      "android": {
        "serviceAccountKeyPath": "/root/.secrets/keepit-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
