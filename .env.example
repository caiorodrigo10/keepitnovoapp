# ============================================
# KEEPIT — Environment Configuration
# ============================================
# Copie para .env e preencha os valores reais.
# NÃO faça commit do .env (já está no .gitignore).
#
# Ordem de preenchimento sugerida:
#   1. Supabase (essencial pra rodar o backend)
#   2. Asaas sandbox (essencial pra testar pagamento)
#   3. Zenvia (só quando implementar cadastro com SMS)
#   4. Expo (só na hora do build/publish)
#   5. Deploys e observabilidade (opcionais)
# ============================================


# --------------------------------------------
# 1. Supabase — backend (DB + Auth + Storage + Edge Functions)
# --------------------------------------------
# Crie o projeto em https://supabase.com/dashboard
# Copie os valores de: Project Settings → API
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY tem poder total — SÓ no backend/Edge Functions.
#    Nunca expor no app mobile ou no admin web.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque-aqui-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key


# --------------------------------------------
# 2. Asaas — gateway de pagamento (PIX + cartão + subcontas)
# --------------------------------------------
# Sandbox: crie em https://sandbox.asaas.com (aberto, gratuito)
# Produção: https://www.asaas.com (após aprovação comercial)
#
# ASAAS_WEBHOOK_TOKEN: string aleatória que você gera, usada pra validar
# que o webhook recebido é mesmo do Asaas (comparar com header do request).
ASAAS_API_KEY=coloque-aqui-a-api-key
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=gerar-uma-string-aleatoria-longa-aqui


# --------------------------------------------
# 3. Zenvia — SMS de confirmação de telefone do cliente
# --------------------------------------------
# https://app.zenvia.com/home/api
# Volume MVP estimado: R$ 10-50/mês
ZENVIA_API_TOKEN=coloque-aqui-o-token


# --------------------------------------------
# 4. Expo — push notifications e EAS builds
# --------------------------------------------
# https://expo.dev/settings/access-tokens
# Cria uma conta na Expo (grátis) e gera um Personal Access Token.
EXPO_ACCESS_TOKEN=coloque-aqui-o-access-token


# --------------------------------------------
# 5. Deploys — opcional (usar se automatizar via CI/CD)
# --------------------------------------------
VERCEL_TOKEN=
GITHUB_TOKEN=


# --------------------------------------------
# 6. Observabilidade — opcional (pode entrar depois do lançamento)
# --------------------------------------------
# https://sentry.io — error tracking para os apps e backend.
SENTRY_DSN=


# ============================================
# AIOX — framework interno de desenvolvimento assistido por IA
# ============================================
# Só preencha se quiser rodar agentes AIOX fora do Claude Code
# (Claude Code usa a assinatura, não precisa da chave direta).
# ============================================

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Pesquisa (usada pelos agentes AIOX para research)
EXA_API_KEY=
CONTEXT7_API_KEY=


# ============================================
# Config geral do ambiente
# ============================================
NODE_ENV=development
AIOX_VERSION=5.2.9


# ============================================
# NOTA — regras de negócio parametrizáveis
# ============================================
# Valores como taxa Keepit (12%), ticket mínimo (R$ 20), timeout de aceite
# (10 min), etc. NÃO ficam aqui. Eles vão em arquivo de config no código
# (ex: packages/config/business-rules.ts), versionado com o repositório.
#
# Racional: são regras de negócio, não segredos nem config por ambiente.
# Devem ser as mesmas em dev/staging/produção.
#
# Ver docs/PERGUNTAS_REGRAS_NEGOCIO.md para a lista completa de decisões.
# ============================================
